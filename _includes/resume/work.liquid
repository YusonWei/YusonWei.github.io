<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign work = data[1] | sort: 'startDate' | reverse %}
  {% for content in work %}
    {% assign name_parts = content.name | split: '–' %}
    {% if name_parts.size > 1 %}
      {% assign proj_source = name_parts | first | strip %}
      {% assign proj_name = name_parts | last | strip %}
    {% else %}
      {% assign proj_source = '' %}
      {% assign proj_name = content.name %}
    {% endif %}
    {% if content.startDate %}
      {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
      {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
      {% assign period = startDate | append: ' - ' | append: endDate %}
    {% else %}
      {% assign period = '' %}
    {% endif %}
    <li class="list-group-item">
      <div class="ml-1 ml-md-4">
        <div class="font-weight-bold" style="color: var(--global-theme-color)">{{ proj_name }}</div>
        {% if proj_source != '' %}<div>{{ proj_source }}</div>{% endif %}
        <div class="font-weight-bold" style="color: var(--global-theme-color)">{{ content.position }}</div>
        {% if period != '' %}<div>{{ period }}</div>{% endif %}
        {% if content.location %}<div>{{ content.location }}</div>{% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
